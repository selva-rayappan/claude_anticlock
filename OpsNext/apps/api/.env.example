# ═══════════════════════════════════════════════════════════════════
# OpsNext API — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════

# Core
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug
API_BASE_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://opsnext:opsnext@localhost:5432/opsnext?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-64-chars
JWT_ACCESS_TOKEN_EXPIRY=8h
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
JWT_RS256_PRIVATE_KEY=
JWT_RS256_PUBLIC_KEY=

# Session
COOKIE_SECRET=change-me-to-a-different-secure-secret

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@opsnext.io
FROM_NAME=OpsNext

# File Storage (S3 / Cloudflare R2)
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_IMPORTS=opsnext-imports-dev
S3_BUCKET_EXPORTS=opsnext-exports-dev
S3_BUCKET_ATTACHMENTS=opsnext-attachments-dev

# Search (Typesense)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=opsnext-local-key

# Stripe (Billing)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BASIC=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry (Error Tracking)
SENTRY_DSN=

# Frontend URL (for CORS and email links)
WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Twilio (SMS / MFA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=opsnext-api
