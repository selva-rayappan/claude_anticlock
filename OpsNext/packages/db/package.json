{
  "name": "@opsnext/db",
  "version": "0.0.1",
  "private": true,
  "description": "Prisma ORM client, schema, and database utilities for OpsNext",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./tenant-client": "./src/tenant-client.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed/index.ts",
    "db:reset": "prisma migrate reset",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opsnext/config": "workspace:*",
    "@opsnext/shared": "workspace:*",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
