{
  "name": "@opsnext/config",
  "version": "0.0.1",
  "private": true,
  "description": "Shared ESLint, TypeScript, Tailwind, and environment config for OpsNext",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/next": "./eslint/next.js",
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/nextjs": "./tsconfig/nextjs.json",
    "./tsconfig/node": "./tsconfig/node.json",
    "./env": "./src/env.ts"
  },
  "main": "./src/env.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint for config package'"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
